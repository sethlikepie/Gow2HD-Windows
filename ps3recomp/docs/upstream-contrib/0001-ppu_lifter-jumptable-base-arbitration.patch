+def test_scalar_toc_does_not_explode():
+    """Older callers pass an int (or None) instead of a candidate list."""
+    insns = decode_all([w_cmplwi(0, 9, 1), w_lwz(11, 2, 16), w_lwzx(0, 9, 11),
+                        w_mtctr(0), w_bctr()])
+    mem = {TOC + 16: 0x200300, 0x200300: 0x14000, 0x200304: 0x0}
+    try:
+        tables = discover_jump_tables(insns, mem_reader(mem), TOC, TEXT_LO, TEXT_HI)
+        ok_int = tables.get(insns[-1].addr) == [0x14000]
+    except Exception as exc:                                   # noqa: BLE001
+        ok_int = False
+        print(f"[jt] exception with int toc: {exc!r}")
+    check("scalar toc accepted", ok_int)
+    try:
+        discover_jump_tables(insns, mem_reader(mem), None, TEXT_LO, TEXT_HI)
+        ok_none = True
+    except Exception as exc:                                   # noqa: BLE001
+        ok_none = False
+        print(f"[jt] exception with toc=None: {exc!r}")
+    check("toc=None does not raise", ok_none)

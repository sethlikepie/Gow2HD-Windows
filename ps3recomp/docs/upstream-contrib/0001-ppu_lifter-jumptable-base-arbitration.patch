+def test_multi_toc():
+    """Multi-TOC: the wrong candidate reads junk; the one validating targets wins."""
+    insns = decode_all([w_cmplwi(0, 9, 2), w_lwz(11, 2, 16), w_lwzx(0, 9, 11),
+                        w_mtctr(0), w_bctr()])
+    bad_toc, good_toc, table = 0x400000, TOC, 0x200200
+    mem = {bad_toc + 16: 0xDEADBEEF,                 # points outside -> 0 targets
+           good_toc + 16: table,
+           table + 0: 0x13000, table + 4: 0x13004, table + 8: 0x0}
+    tables = discover_jump_tables(insns, mem_reader(mem), [bad_toc, good_toc],
+                                  TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("multi-TOC picks the candidate that validates targets",
+          got == [0x13000, 0x13004], f"got={got}")
+
+
+def test_offset_first_operand_collision():
+    """Offset table, index operand first and also TOC-loaded.
+
+    The `add` names the real base, so the syntactic reordering fires and this
+    case already resolves. It is kept as a CONTROL: without a vector where both
+    the old and the new arbitration agree, a green differential cannot tell a
+    real defect from a biased harness.
+
+        lwz   r9,  8(r2)     <- TOC-loaded, but NOT the table
+        lwz   r11, 16(r2)    <- the real base
+        lwzx  r0,  r9, r11   <- index first, base second
+        add   r0,  r0, r11   <- the `add` names r11
+        mtctr r0 ; bctr
+    """
+    insns = decode_all([w_cmplwi(0, 9, 2), w_lwz(9, 2, 8), w_lwz(11, 2, 16),
+                        w_lwzx(0, 9, 11), w_add(0, 0, 11), w_mtctr(0), w_bctr()])
+    table = 0x11000
+    mem = {TOC + 8: 0x18000, 0x18000: 0xDEADBEEF, 0x18004: 0xDEADBEEF,
+           TOC + 16: table,
+           table + 0: 0x100, table + 4: 0x200, table + 8: 0xFFFFFFFF}
+    tables = discover_jump_tables(insns, mem_reader(mem), [TOC], TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("offset + first-operand collision", got == [0x11100, 0x11200], f"got={got}")
+
+
+def test_absolute_first_operand_collision():
+    """ABSOLUTE table, no `add`: the reordering has nothing to act on.
+
+    This is the vector the base-register arbitration exists for. Both lwzx
+    operands carry a TOC load and the wrong one comes first; selecting the first
+    candidate that decodes reads an unrelated table, validates zero targets and
+    drops the dispatcher silently.
+
+        cmplwi cr0, r9, 2
+        lwz    r9,  8(r2)      <- TOC-loaded, but NOT the table
+        lwz    r11, 16(r2)     <- the real base
+        lwzx   r0,  r9, r11    <- index first, base second
+        mtctr  r0 ; bctr       <- no `add`: the table is ABSOLUTE
+    """
+    insns = decode_all([w_cmplwi(0, 9, 2), w_lwz(9, 2, 8), w_lwz(11, 2, 16),
+                        w_lwzx(0, 9, 11), w_mtctr(0), w_bctr()])
+    table, junk = 0x200400, 0x18000
+    mem = {TOC + 8: junk, junk + 0: 0xDEADBEEF, junk + 4: 0xDEADBEEF,
+           TOC + 16: table,
+           table + 0: 0x13000, table + 4: 0x13004, table + 8: 0x13008,
+           table + 12: 0x0}
+    tables = discover_jump_tables(insns, mem_reader(mem), [TOC], TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("absolute + first-operand collision (the dropped dispatcher)",
+          got == [0x13000, 0x13004, 0x13008], f"got={got}")
+

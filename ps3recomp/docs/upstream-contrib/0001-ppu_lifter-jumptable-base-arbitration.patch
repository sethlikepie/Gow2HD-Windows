+#!/usr/bin/env python3
+"""Unit vectors for discover_jump_tables (computed bctr switch discovery).
+
+No SDK, no ELF, no network: the PowerPC words are hand-assembled and memory is
+served by a dict, so the whole file runs anywhere python3 does.
+
+What these pin, in order of how expensive the bug was:
+
+  * The table-base register is ARBITRATED by validated target count, not
+    SELECTED by syntax. `lwzx rD, rA, rB` computes MEM(rA+rB) and either
+    operand can be the base; both are frequently TOC-loaded, because the
+    30-instruction backward window bleeds across the function boundary and the
+    index register collides with a stale `lwz idx,d(r2)` from the preceding
+    function -- the collision the comment inside the function already
+    describes. The `add`-based reordering above the walk covers that only when
+    an `add` is present, i.e. on OFFSET tables. On an ABSOLUTE table there is
+    no `add`, the candidate order stays the raw operand order, the wrong base
+    is read, nothing validates, `best` stays empty and the whole dispatcher is
+    dropped in silence (see test_absolute_first_operand_collision).
+
+  * The pre-existing behaviours that must not move while doing that: one-level
+    and two-level bases, offset tables, multi-TOC arbitration, and scalar/None
+    `toc` arguments from older callers.
+"""
+
+import os
+import sys
+
+TOOLS = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, TOOLS)
+
+import ppu_disasm                                   # noqa: E402
+from ppu_lifter import discover_jump_tables         # noqa: E402
+
+TEXT_LO, TEXT_HI = 0x10000, 0x20000
+TOC = 0x100000
+
+
+def w_cmplwi(bf, ra, ui):  return (10 << 26) | (bf << 23) | (ra << 16) | (ui & 0xFFFF)
+def w_lwz(rt, ra, d):      return (32 << 26) | (rt << 21) | (ra << 16) | (d & 0xFFFF)
+def w_lwzx(rt, ra, rb):    return (31 << 26) | (rt << 21) | (ra << 16) | (rb << 11) | (23 << 1)
+def w_add(rt, ra, rb):     return (31 << 26) | (rt << 21) | (ra << 16) | (rb << 11) | (266 << 1)
+def w_bctr():              return (19 << 26) | (20 << 21) | (528 << 1)
+
+
+def w_mtctr(rs):
+    spr = ((9 & 0x1F) << 5) | ((9 >> 5) & 0x1F)     # CTR is SPR 9, halves swapped
+    return (31 << 26) | (rs << 21) | (spr << 11) | (467 << 1)
+
+
+def decode_all(words, base=TEXT_LO):
+    return [ppu_disasm.decode(w, base + 4 * i) for i, w in enumerate(words)]
+
+
+def mem_reader(mem):
+    def read_u32(a):
+        return mem.get(a & 0xFFFFFFFF)
+    return read_u32
+
+
+FAILS = []
+
+
+def check(name, cond, detail=""):
+    if cond:
+        print(f"[jt] ok   {name}")
+    else:
+        print(f"[jt] FAIL {name} {detail}")
+        FAILS.append(name)
+
+
+def test_encodings():
+    """The hand-assembled words must decode to what the vectors below assume."""
+    ins = decode_all([w_cmplwi(0, 9, 3), w_lwz(11, 2, 16), w_lwzx(0, 9, 11),
+                      w_add(0, 0, 11), w_mtctr(0), w_bctr()])
+    got = [i.mnemonic for i in ins]
+    check("encodings decode as expected",
+          got == ['cmplwi', 'lwz', 'lwzx', 'add', 'mtctr', 'bctr'], f"got={got}")
+
+
+def test_one_level_absolute():
+    """gcc one-level idiom: lwz base,d(r2); lwzx val,idx,base; mtctr; bctr."""
+    insns = decode_all([w_cmplwi(0, 9, 3), w_lwz(11, 2, 16), w_lwzx(0, 9, 11),
+                        w_mtctr(0), w_bctr()])
+    table = 0x200000
+    mem = {TOC + 16: table,
+           table + 0: 0x11000, table + 4: 0x11004, table + 8: 0x11008,
+           table + 12: 0x0}                          # out of .text -> stop here
+    tables = discover_jump_tables(insns, mem_reader(mem), [TOC], TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("one-level absolute", got == [0x11000, 0x11004, 0x11008], f"got={got}")
+
+
+def test_two_level_indirection():
+    """PIC idiom: lwz mid,d1(r2); lwz base,d2(mid) -- the table is two hops out."""
+    insns = decode_all([w_cmplwi(0, 9, 2), w_lwz(10, 2, 32), w_lwz(11, 10, 8),
+                        w_lwzx(0, 9, 11), w_mtctr(0), w_bctr()])
+    glob, table = 0x300000, 0x200100
+    mem = {TOC + 32: glob, glob + 8: table,
+           table + 0: 0x12000, table + 4: 0x12004, table + 8: 0x0}
+    tables = discover_jump_tables(insns, mem_reader(mem), [TOC], TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("two-level indirection", got == [0x12000, 0x12004], f"got={got}")
+
+
+def test_offset_table():
+    """Offset table: each entry is a signed displacement from the table base."""
+    insns = decode_all([w_cmplwi(0, 9, 2), w_lwz(11, 2, 16), w_lwzx(0, 9, 11),
+                        w_add(0, 0, 11), w_mtctr(0), w_bctr()])
+    table = 0x11000                                  # base inside .text, as in the real idiom
+    mem = {TOC + 16: table,
+           table + 0: 0x100, table + 4: 0x200, table + 8: 0xFFFFFFFF}
+    tables = discover_jump_tables(insns, mem_reader(mem), [TOC], TEXT_LO, TEXT_HI)
+    got = tables.get(insns[-1].addr)
+    check("offset table: base + displacement", got == [0x11100, 0x11200], f"got={got}")

+#include <signal.h>
+extern "C" volatile int g_ps3_rperma_full;
+enum { PS3_FLIPP_FN_N = 6 };
+static const char* const g_ps3_flipp_fn_name[PS3_FLIPP_FN_N] = {
+    "14FE18","156680","B71B8","2B2E74","2EFD60","2EFDA4"
+};

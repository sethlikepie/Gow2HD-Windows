<Configuration>
  <Networking>Enable</Networking>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>__HOST__</HostFolder>
      <SandboxFolder>C:\sbx</SandboxFolder>
      <ReadOnly>false</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <LogonCommand>
    <Command>cmd /c C:\sbx\run_in_sandbox.cmd</Command>
  </LogonCommand>
</Configuration>
